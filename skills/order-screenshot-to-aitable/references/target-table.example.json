{
  "_comment": "目标多维表配置示例。复制为 target-table.json 后填入你自己的信息。字段 ID 必须来自实时 field get，不要凭记忆填写。",
  "target": {
    "baseId": "YOUR_BASE_ID",
    "tableId": "YOUR_TABLE_ID",
    "tableName": "订单录入（投放）",
    "viewId": "YOUR_VIEW_ID",
    "viewName": "总表单"
  },
  "fields": {
    "orderNo": {
      "fieldId": "YOUR_ORDER_NO_FIELD_ID",
      "name": "订单编号",
      "requiredType": "text",
      "note": "必须是文本类型。数字类型会让 19 位订单号被四舍五入，且不可逆。"
    },
    "orderTime": {
      "fieldId": "YOUR_ORDER_TIME_FIELD_ID",
      "name": "用户下单日期",
      "requiredType": "date"
    },
    "phone": {
      "fieldId": "YOUR_PHONE_FIELD_ID",
      "name": "虚拟手机号",
      "requiredType": "text"
    },
    "remark": {
      "fieldId": "YOUR_REMARK_FIELD_ID",
      "name": "订单备注",
      "requiredType": "text",
      "optional": true,
      "note": "可选。仅当使用者提供了备注内容时才写入；没有备注时不写这一列。"
    }
  },
  "readOnlyFields": [
    { "fieldId": "YOUR_FIELD_ID", "name": "进量编号", "type": "autoNumber" },
    { "fieldId": "YOUR_FIELD_ID", "name": "发货地址", "type": "filterUp" },
    { "fieldId": "YOUR_FIELD_ID", "name": "发货备注", "type": "filterUp" },
    { "fieldId": "YOUR_FIELD_ID", "name": "核销码", "type": "filterUp" }
  ],
  "defaults": {
    "_note": "承接助教不在本 skill 的处理范围内，这里不再保留其字段配置。",
    "orderNoLength": 19
  }
}
